# Node & Dependency Directories
node_modules/
frontend/node_modules/
backend/node_modules/

# Production Build Output (Generated on deployment server via npm run build)
# Note: frontend/dist can be built cleanly anytime via `npm run build`
frontend/dist/

# Privacy & Security: Sensitive Files, Credentials & Environment
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.pfx
*.p12

# Privacy & Security: Temporary Scan Workspaces & Uploaded User Source Code
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
scratch/
tests/tmp_*

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.system_generated/

# OS Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# SQLite Temporary Lock & Journal Files (Keep base ecdat.db for demo seed)
*.db-journal
*.db-wal
*.db-shm
